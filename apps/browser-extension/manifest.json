{
  "manifest_version": 3,
  "name": "工作台 i8 会话桥",
  "version": "0.1.7",
  "description": "通过已登录的 i8 标签执行工作台取数及设备同步。不读 Cookie，不登录，不顶号。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "临时允许工作台使用当前 i8 标签"
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1:8000/*",
      "http://localhost:8000/*",
      "http://127.0.0.1:8065/*",
      "http://localhost:8065/*",
      "http://192.168.5.3:8000/*"
    ]
  }
}
