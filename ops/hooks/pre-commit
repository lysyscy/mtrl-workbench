#!/bin/sh
# 一人练手项目：提交只核暂存语法、字节与凭据文件；业务和文档按影响入口验一次。
# 文档、台账、变异登记不随每次提交重复扫描；全量/现场核验由用户按需执行。
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 1
PY="$ROOT/backend/.venv/Scripts/python.exe"

# 文件名拦截不依赖Python；真实.env不提交，示例模板放行。
for f in $(git diff --cached --name-only 2>/dev/null); do
  case "$f" in
    .env|.env.*)
      case "$f" in
        *.example) ;;
        *) echo "pre-commit ⛔ 暂存区含口令文件：$f"; exit 1;;
      esac;;
  esac
done
if [ ! -x "$PY" ]; then
  echo "pre-commit ⛔ 找不到venv Python，语法和字节检查未执行"
  exit 1
fi

# 不依赖tail/sed/awk；保留失败末尾输出。
NL='
'
tail_n() {
  _n=${1:-10}; _buf=""; _cnt=0
  while IFS= read -r _line || [ -n "$_line" ]; do
    if [ "$_cnt" -eq 0 ]; then _buf="$_line"; else _buf="$_buf$NL$_line"; fi
    _cnt=$((_cnt + 1))
    if [ "$_cnt" -gt "$_n" ]; then _buf="${_buf#*"$NL"}"; _cnt=$((_cnt - 1)); fi
  done
  printf '%s\n' "$_buf"
}
bad=""
for spec in \
  "tools/audit/syntax_audit.py --staged" \
  "tools/audit/bytes_guard.py --staged"
do
  set -- $spec
  script="$1"; shift
  out=$("$PY" -X utf8 "$ROOT/$script" "$@" 2>&1); rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "pre-commit ✅ $script $*"
  else
    echo "pre-commit ⛔ $script $*（rc=$rc）"
    printf '%s\n' "$out" | tail_n 10
    bad="$bad $script"
  fi
done
if [ -n "$bad" ]; then echo "pre-commit：相关检查失败，先修再提交"; exit 1; fi
echo "pre-commit：暂存语法、字节及凭据文件检查通过"
exit 0
